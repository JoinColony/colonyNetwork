{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.10.0",
    "generators": {
      "typescript-fetch": {
        "generatorName": "typescript-fetch",
        "inputSpec": "https://api.wormholescan.io/swagger.json",
        "output": "#{cwd}/openapi-generated-types"
      }
    }
  }
}
